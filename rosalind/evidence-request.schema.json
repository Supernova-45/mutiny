{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectedCandidateIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateContexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "hla": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "mappingStatus": {
            "enum": [
              "verified",
              "unresolved",
              "not_requested"
            ]
          }
        },
        "required": [
          "candidateId",
          "sequence",
          "role",
          "hla",
          "reference",
          "mappingStatus"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissibleSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "sha256",
          "path",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "projectId",
    "projectFingerprint",
    "selectedCandidateIds",
    "candidateContexts",
    "questions",
    "permissibleSources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit selected-subset evidence request"
}
