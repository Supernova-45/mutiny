{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "identityProfile": {
      "const": "mutiny-canonical-json-1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "scientificDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "returnId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectedCandidateIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved",
              "no_exact_match",
              "unsupported"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "searchScope": {
            "type": "object"
          }
        },
        "required": [
          "candidateId",
          "status",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "candidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidenceLevel": {
            "enum": [
              "fixture_identity",
              "exact_experimental",
              "related_context"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "details": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "candidateIds",
          "evidenceLevel",
          "claim",
          "sources",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "proposedCorrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "current": {},
          "proposed": {},
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applyAutomatically": {
            "const": false
          }
        },
        "required": [
          "id",
          "candidateId",
          "field",
          "current",
          "proposed",
          "reason",
          "evidenceIds",
          "applyAutomatically"
        ],
        "additionalProperties": false
      }
    },
    "returnDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "identityProfile",
    "projectId",
    "scientificDigest",
    "returnId",
    "requestId",
    "requestDigest",
    "contextDigest",
    "selectedCandidateIds",
    "findings",
    "claims",
    "proposedCorrections",
    "returnDigest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supernova-45.github.io/mutiny/proposals/exchange/0.2.0/return",
  "title": "Proposed 0.2.0 return; not a reinterpretation of 0.1.0"
}
